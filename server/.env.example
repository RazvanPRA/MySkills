# Copy to .env (gitignored) and fill in. Every secret lives only in .env, never in git.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://senior_prep:senior_prep_dev@localhost:5433/senior_prep
# The single credential of this single-user server; the app sends it in the x-api-key header.
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
API_KEY=change-me-to-at-least-32-random-characters
# 5d: Claude API key, server side only. Never put it in the app.
# ANTHROPIC_API_KEY=
