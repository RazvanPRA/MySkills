# Copy to .env (gitignored). Values here are for local development only.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://senior_prep:senior_prep_dev@localhost:5433/senior_prep
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters
# 5d: Claude API key, server side only. Never put it in the app.
# ANTHROPIC_API_KEY=
